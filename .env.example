# Environment Variables Template for FoodConnect Bharat

# Application Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="FoodConnect Bharat"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Connection (PostgreSQL / SQLite fallback)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/foodconnect_bharat?schema=public"

# Maps API (OpenStreetMap default / Mapbox option)
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your_mapbox_token_here_optional"

# Socket.IO / WebSockets Realtime Server
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"

# AI Smart Suggestions Engine (Optional API Key)
AI_API_KEY="sk-your-ai-api-key-here"

# Authentication Secrets
NEXTAUTH_SECRET="your-super-secret-nextauth-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
